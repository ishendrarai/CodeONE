# ==============================================================================
# docker/Dockerfile.server - Production Express Backend Container
# Node.js 22 LTS / Prisma Client Generation
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies and generate Prisma client
RUN npm ci --omit=dev && npx prisma generate

# Copy application source code
COPY src/ ./src/

EXPOSE 5000

CMD ["node", "src/server.js"]
