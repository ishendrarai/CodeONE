// ==============================================================================
// CodeONE Prisma Database Schema
// Database: PostgreSQL 15+
// Architecture: 15 Logical Groups / 17 Physical SQL Tables
// Source of Truth: CodeONE Technical Documentation (Chapter 4)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. User Management (users)
// ------------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  passwordHash  String?   @map("password_hash") @db.Text
  avatarUrl     String?   @map("avatar_url") @db.Text
  role          String    @default("user") @db.VarChar(20) // 'user', 'moderator', 'admin', 'auditor'
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLogin     DateTime? @map("last_login") @db.Timestamptz
  settings      Json      @default("{}")

  // Relationships
  oauthAccounts    OAuthAccount[]
  sessions         UserSession[]
  platformAccounts PlatformAccount[]
  userProblems     UserProblem[]
  goals            Goal[]
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("ActorAuditLogs")

  @@map("users")
}

// ------------------------------------------------------------------------------
// 2. Authentication & OAuth (oauth_accounts)
// ------------------------------------------------------------------------------
model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(30) // 'google', 'github'
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

// ------------------------------------------------------------------------------
// 3. User Sessions (user_sessions)
// ------------------------------------------------------------------------------
model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid // Groups token lineage for reuse detection
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId], name: "idx_user_sessions_user")
  @@map("user_sessions")
}

// ------------------------------------------------------------------------------
// 4. Refresh Tokens (refresh_tokens)
// ------------------------------------------------------------------------------
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255) // SHA-256 hash only
  isRevoked  Boolean   @default(false) @map("is_revoked")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  replacedBy String?   @map("replaced_by") @db.Uuid

  session       UserSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedToken RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [id])
  parentTokens  RefreshToken[] @relation("TokenRotation")

  @@map("refresh_tokens")
}

// ------------------------------------------------------------------------------
// 5. Platform Accounts (platform_accounts)
// ------------------------------------------------------------------------------
model PlatformAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  platformName       String    @map("platform_name") @db.VarChar(50)
  username           String    @db.VarChar(100)
  verificationStatus String    @default("unverified") @map("verification_status") @db.VarChar(20) // 'unverified', 'pending', 'verified', 'failed'
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  rating             Int?
  rank               String?   @db.VarChar(50)
  lastSynced         DateTime? @map("last_synced") @db.Timestamptz
  isActive           Boolean   @default(true) @map("is_active")
  syncFrequency      Int       @default(3600) @map("sync_frequency") // in seconds

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions           Submission[]
  ratingHistory         RatingHistory[]
  contestParticipations ContestParticipation[]
  syncLogs              SyncLog[]

  @@unique([userId, platformName])
  @@index([userId], name: "idx_platform_accounts_user")
  @@map("platform_accounts")
}

// ------------------------------------------------------------------------------
// 6. Problems Catalogue (problems, tags, problem_tags)
// ------------------------------------------------------------------------------
model Problem {
  id               String   @id @default(uuid()) @db.Uuid
  platform         String   @db.VarChar(50)
  problemId        String   @map("problem_id") @db.VarChar(100)
  title            String   @db.VarChar(255)
  difficulty       String?  @db.VarChar(20) // 'easy', 'medium', 'hard'
  difficultyRating Int?     @map("difficulty_rating")
  url              String   @db.Text
  acceptanceRate   Decimal? @map("acceptance_rate") @db.Decimal(5, 2)
  addedAt          DateTime @default(now()) @map("added_at") @db.Timestamptz

  problemTags  ProblemTag[]
  userProblems UserProblem[]
  submissions  Submission[]

  @@unique([platform, problemId])
  @@index([difficulty], name: "idx_problems_difficulty")
  @@map("problems")
}

model Tag {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(50)
  category String? @db.VarChar(50)

  problemTags ProblemTag[]

  @@map("tags")
}

model ProblemTag {
  problemId String @map("problem_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tags")
}

// ------------------------------------------------------------------------------
// 7. User Problems (user_problems) - Mutable State
// ------------------------------------------------------------------------------
model UserProblem {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  problemId    String    @map("problem_id") @db.Uuid
  status       String    @db.VarChar(20) // 'solved', 'in_progress', 'review_later', 'todo'
  isBookmarked Boolean   @default(false) @map("is_bookmarked")
  attempts     Int       @default(1)
  solvedAt     DateTime? @map("solved_at") @db.Timestamptz
  notes        String?   @db.Text

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status], name: "idx_user_problems_user_status")
  @@index([solvedAt], name: "idx_user_problems_solved_at")
  @@map("user_problems")
}

// ------------------------------------------------------------------------------
// 8. Submissions (submissions) - Immutable History (Streaks Source of Truth)
// ------------------------------------------------------------------------------
model Submission {
  id                String   @id @default(uuid()) @db.Uuid
  platformAccountId String   @map("platform_account_id") @db.Uuid
  problemId         String?  @map("problem_id") @db.Uuid
  externalId        String   @map("external_id") @db.VarChar(100)
  verdict           String   @db.VarChar(30)
  language          String?  @db.VarChar(50)
  submittedAt       DateTime @map("submitted_at") @db.Timestamptz

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  problem         Problem?        @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@unique([platformAccountId, externalId])
  @@index([platformAccountId, submittedAt(sort: Desc)], name: "idx_submissions_account_time")
  @@map("submissions")
}

// ------------------------------------------------------------------------------
// 9. Rating History (rating_history)
// ------------------------------------------------------------------------------
model RatingHistory {
  id                String   @id @default(uuid()) @db.Uuid
  platformAccountId String   @map("platform_account_id") @db.Uuid
  contestId         String?  @map("contest_id") @db.Uuid
  oldRating         Int?     @map("old_rating")
  newRating         Int      @map("new_rating")
  recordedAt        DateTime @map("recorded_at") @db.Timestamptz

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  contest         Contest?        @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([platformAccountId, recordedAt], name: "idx_rating_history_account_time")
  @@map("rating_history")
}

// ------------------------------------------------------------------------------
// 10. Contests Calendar (contests)
// ------------------------------------------------------------------------------
model Contest {
  id              String   @id @default(uuid()) @db.Uuid
  platform        String   @db.VarChar(50)
  externalId      String?  @map("external_id") @db.VarChar(100)
  name            String   @db.VarChar(255)
  startTime       DateTime @map("start_time") @db.Timestamptz
  durationSeconds Int      @map("duration_seconds")
  url             String?  @db.Text
  source          String?  @db.VarChar(50) // 'clist', 'codeforces'

  ratingHistory         RatingHistory[]
  contestParticipations ContestParticipation[]

  @@unique([platform, externalId])
  @@index([startTime], name: "idx_contests_start")
  @@map("contests")
}

// ------------------------------------------------------------------------------
// 11. Contest Participations (contest_participations)
// ------------------------------------------------------------------------------
model ContestParticipation {
  id                String @id @default(uuid()) @db.Uuid
  platformAccountId String @map("platform_account_id") @db.Uuid
  contestId         String @map("contest_id") @db.Uuid
  rank              Int?
  solvedCount       Int?   @map("solved_count")
  ratingChange      Int?   @map("rating_change")

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  contest         Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([platformAccountId, contestId])
  @@map("contest_participations")
}

// ------------------------------------------------------------------------------
// 12. Goals (goals)
// ------------------------------------------------------------------------------
model Goal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(20) // 'daily', 'weekly', 'monthly'
  target    Int
  current   Int      @default(0)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// ------------------------------------------------------------------------------
// 13. Notifications (notifications)
// ------------------------------------------------------------------------------
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50) // 'contest_reminder', 'streak_alert', etc.
  title     String    @db.VarChar(150)
  body      String?   @db.Text
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt], name: "idx_notifications_user_unread")
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 14. Sync Logs (sync_logs)
// ------------------------------------------------------------------------------
model SyncLog {
  id                String    @id @default(uuid()) @db.Uuid
  platformAccountId String    @map("platform_account_id") @db.Uuid
  status            String    @db.VarChar(20) // 'running', 'success', 'partial', 'failed', 'rate_limited'
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz
  recordsFetched    Int       @default(0) @map("records_fetched")
  errorMessage      String?   @map("error_message") @db.Text

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([platformAccountId, startedAt(sort: Desc)], name: "idx_sync_logs_account_time")
  @@map("sync_logs")
}

// ------------------------------------------------------------------------------
// 15. Security Audit Logs (audit_logs) - Append-Only
// ------------------------------------------------------------------------------
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorRole    String   @map("actor_role") @db.VarChar(50)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  status       String   @db.VarChar(20) // 'success', 'failure', 'denied'
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId], name: "idx_audit_logs_actor")
  @@index([action], name: "idx_audit_logs_action")
  @@index([createdAt], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}
