# ==============================================================================
# server/.env.example - Backend Environment Configuration Template
# Layer: Configuration / Infrastructure
# Responsibility: Documents required and optional environment keys for local development.
# Security Note: Never commit production values or real secrets to version control.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 15+ via Prisma ORM)
DATABASE_URL=postgresql://codeone_user:change-me-locally@localhost:5432/codeone

# Hybrid Authentication & Security (15m in-memory access token + 7d rotating refresh cookie)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-long-random-cookie-secret

# OAuth 2.0 Identity Providers (Server-side flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/github/callback

# Email Notification Service (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CodeONE <noreply@codeone.app>"

# Optional Cache & Background Queues (Staged Redis 7+)
REDIS_URL=

# Optional Contest Aggregator (CLIST.by API v4)
CLIST_USERNAME=
CLIST_API_KEY=

# Optional Codeforces Credentials (Only if private data access is required)
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=

# Rate Limiting & Logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
LOG_LEVEL=debug
