# ==============================================================================
# client/.env.example - Frontend Environment Configuration Template
# Layer: Frontend / Configuration
# Responsibility: Documents client runtime environment variables for Vite SPA.
# ==============================================================================

# Backend API Endpoint (versioned under /api/v1)
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT=10000

# Feature Flags & Preferences
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
