{
  "name": "codeone",
  "version": "1.0.0",
  "description": "CodeONE - Unified Intelligence Layer & Analytics Platform for Competitive Programmers",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=server",
    "test:coverage": "npm run test:coverage --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "competitive-programming",
    "leetcode",
    "codeforces",
    "hackerrank",
    "atcoder",
    "codechef",
    "analytics",
    "dashboard",
    "full-stack"
  ],
  "author": "CodeONE Team",
  "license": "MIT"
}

